{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archmap:schema:2",
  "title": "archmap v2",
  "description": "Architecture model designed for selective reading by humans and LLMs. Four document kinds: index, unit, flow and view. Units are architectural subsystems or runtime units, not necessarily deployables. Views select a useful projection of the model and intentionally contain no layout coordinates. Elements are addressed by dotted references: 'unit' or 'unit.component'. Inside a unit file, '.component' is shorthand for a component of that same unit. Relations live with their source. Code remains authoritative; this model records verified architectural claims about a specific code revision.",
  "type": "object",
  "required": ["archmap", "doc"],
  "properties": {
    "archmap": { "const": 2, "description": "Schema major version." },
    "doc": { "enum": ["index", "unit", "flow", "view"] }
  },
  "allOf": [
    { "if": { "properties": { "doc": { "const": "index" } }, "required": ["doc"] }, "then": { "$ref": "#/$defs/index" } },
    { "if": { "properties": { "doc": { "const": "unit" } }, "required": ["doc"] }, "then": { "$ref": "#/$defs/unit" } },
    { "if": { "properties": { "doc": { "const": "flow" } }, "required": ["doc"] }, "then": { "$ref": "#/$defs/flow" } },
    { "if": { "properties": { "doc": { "const": "view" } }, "required": ["doc"] }, "then": { "$ref": "#/$defs/view" } }
  ],

  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 48,
      "description": "Stable kebab-case identifier. Treat ids as persistent join keys."
    },
    "ref": {
      "type": "string",
      "description": "Reference to an external, unit, unit.component, or (unit files only) .component.",
      "anyOf": [
        { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$" },
        { "pattern": "^\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[^\\n\\r]+$",
      "description": "One line. What it is and why a reader might need it. Catalogue summaries live only in index.yaml."
    },
    "line": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[^\\n\\r]+$",
      "description": "Short single-line text."
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\s\\\\\\x00-\\x1f]+$",
      "description": "Repo-relative POSIX path (file or directory, '.' allowed). No '..', leading '/', whitespace or backslashes."
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" },
      "description": "Repo-relative roots owned by or primarily implementing this architectural element."
    },
    "evidence": {
      "type": "string",
      "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\s\\\\:\\x00-\\x1f]+(?::[1-9][0-9]*(?:-[1-9][0-9]*)?)?$",
      "description": "Repo-relative path, path:LINE or path:START-END proving a claim at that document's verified revision."
    },
    "notes": {
      "type": "string",
      "pattern": "^notes/(?!(?:.*/)?\\.\\.(?:/|$))[^\\s\\\\]+\\.md$",
      "description": "Link to prose with rationale, decisions or pitfalls."
    },
    "confidence": {
      "enum": ["confirmed", "inferred"],
      "description": "confirmed = checked against code at this document's verified revision and evidence is required. inferred = useful hypothesis to verify."
    },
    "status": { "enum": ["active", "experimental", "deprecated", "planned"] },
    "tech": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\n\\r]+$" }
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "symbol-anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\n\\r]+$",
          "description": "Selective declaration/name-path query for a symbol-aware navigator such as Serena. This is a starting point, not an exhaustive symbol inventory."
        },
        "path": { "$ref": "#/$defs/path" },
        "role": { "$ref": "#/$defs/line" }
      },
      "description": "Stable-ish semantic bridge into derived symbol navigation. Symbol anchors are navigation hints, not verification evidence."
    },
    "symbol-anchors": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/symbol-anchor" },
      "description": "Small, curated symbol starting points. Expand callers/references/implementations with a symbol tool instead of copying that graph into archmap."
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "verified_on"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "verified_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Quoted ISO date." }
      },
      "description": "Code revision against which this document was last checked. Freshness is per document, not global."
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "confidence"],
      "properties": {
        "text": { "$ref": "#/$defs/line" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "uniqueItems": true, "maxItems": 5 },
        "symbols": { "$ref": "#/$defs/symbol-anchors" }
      },
      "patternProperties": { "^x-": {} },
      "if": { "properties": { "confidence": { "const": "confirmed" } }, "required": ["confidence"] },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    },
    "invariants": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/claim" },
      "description": "Architecturally important rules. Confirmed invariants carry evidence like relations do."
    },
    "relation-kind": {
      "enum": ["calls", "reads", "writes", "publishes", "subscribes", "spawns", "configures", "depends-on", "executes-on"],
      "description": "Manually model semantic architecture, not mechanically derivable imports. Import graphs belong to derived tooling/views."
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "confidence"],
      "properties": {
        "from": { "$ref": "#/$defs/ref" },
        "to": { "$ref": "#/$defs/ref" },
        "kind": { "$ref": "#/$defs/relation-kind" },
        "via": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\n\\r]+$", "description": "Mechanism or protocol, e.g. in-process, HTTPS, filesystem." },
        "note": { "$ref": "#/$defs/line" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "uniqueItems": true, "maxItems": 5 },
        "symbols": { "$ref": "#/$defs/symbol-anchors" },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "patternProperties": { "^x-": {} },
      "if": { "properties": { "confidence": { "const": "confirmed" } }, "required": ["confidence"] },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "type", "paths"],
      "properties": {
        "summary": { "$ref": "#/$defs/summary" },
        "type": { "enum": ["module", "package", "handler", "controller", "service", "repository", "adapter", "client", "model", "config", "middleware", "job", "util", "other"] },
        "paths": { "$ref": "#/$defs/paths" },
        "entrypoints": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true, "maxItems": 8 },
        "tech": { "$ref": "#/$defs/tech" },
        "status": { "$ref": "#/$defs/status" },
        "invariants": { "$ref": "#/$defs/invariants" },
        "tags": { "$ref": "#/$defs/tags" },
        "symbols": { "$ref": "#/$defs/symbol-anchors" }
      },
      "patternProperties": { "^x-": {} }
    },
    "catalogue": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": { "summary": { "$ref": "#/$defs/summary" } }
      }
    },

    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archmap", "doc", "verified", "project", "units"],
      "properties": {
        "archmap": { "const": 2 },
        "doc": { "const": "index" },
        "verified": { "$ref": "#/$defs/verified" },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "summary"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/line" },
            "summary": { "$ref": "#/$defs/summary" },
            "languages": { "$ref": "#/$defs/tech" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "branch": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^\\S+$", "description": "Expected code branch/ref. Advisory metadata, checked when --repo is used." }
              }
            }
          },
          "patternProperties": { "^x-": {} }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exhaustive", "fallback"],
          "properties": {
            "exhaustive": { "type": "boolean", "description": "Whether absence from the architecture model can be treated as evidence that a code capability is absent." },
            "fallback": { "$ref": "#/$defs/line", "description": "Reader instruction to use when the selective model has no matching unit or flow." }
          },
          "description": "Declares whether the index is exhaustive and how readers should recover when it is intentionally selective."
        },
        "externals": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "summary"],
            "properties": {
              "type": { "enum": ["person", "system"] },
              "summary": { "$ref": "#/$defs/summary" },
              "notes": { "$ref": "#/$defs/notes" }
            },
            "patternProperties": { "^x-": {} }
          },
          "description": "Actors and third-party systems outside the codebase. Ids share one namespace with units."
        },
        "units": { "$ref": "#/$defs/catalogue" },
        "flows": { "$ref": "#/$defs/catalogue" },
        "views": { "$ref": "#/$defs/catalogue" },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" },
          "description": "Relations whose source is an external. All other relations live in the unit file owning the source."
        },
        "glossary": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9 _./-]{0,47}$" },
          "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 300, "pattern": "^[^\\n\\r]+$" }
        }
      },
      "patternProperties": { "^x-": {} }
    },

    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archmap", "doc", "id", "verified", "type", "paths"],
      "properties": {
        "archmap": { "const": 2 },
        "doc": { "const": "unit" },
        "id": { "$ref": "#/$defs/id" },
        "verified": { "$ref": "#/$defs/verified" },
        "type": { "enum": ["subsystem", "service", "app", "cli", "library", "worker", "batch", "frontend", "gateway", "database", "queue", "cache", "storage", "infra", "other"] },
        "paths": { "$ref": "#/$defs/paths" },
        "entrypoints": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true, "maxItems": 12 },
        "tech": { "$ref": "#/$defs/tech" },
        "status": { "$ref": "#/$defs/status" },
        "notes": { "$ref": "#/$defs/notes" },
        "invariants": { "$ref": "#/$defs/invariants" },
        "tags": { "$ref": "#/$defs/tags" },
        "symbols": { "$ref": "#/$defs/symbol-anchors" },
        "components": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/component" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" },
          "description": "Relations whose source is this unit or one of its components."
        }
      },
      "patternProperties": { "^x-": {} }
    },

    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archmap", "doc", "id", "verified", "trigger", "steps"],
      "properties": {
        "archmap": { "const": 2 },
        "doc": { "const": "flow" },
        "id": { "$ref": "#/$defs/id" },
        "verified": { "$ref": "#/$defs/verified" },
        "trigger": { "$ref": "#/$defs/line" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "description": "Ordered. List position is the sequence.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "action", "confidence"],
            "properties": {
              "from": { "$ref": "#/$defs/ref" },
              "to": { "$ref": "#/$defs/ref" },
              "action": { "$ref": "#/$defs/line" },
              "async": { "type": "boolean" },
              "returns": { "$ref": "#/$defs/line" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "uniqueItems": true, "maxItems": 5 },
              "symbols": { "$ref": "#/$defs/symbol-anchors" },
              "confidence": { "$ref": "#/$defs/confidence" }
            },
            "patternProperties": { "^x-": {} },
            "if": { "properties": { "confidence": { "const": "confirmed" } }, "required": ["confidence"] },
            "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
          }
        },
        "failure_modes": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/line" }
        },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "patternProperties": { "^x-": {} }
    },

    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archmap", "doc", "id", "verified", "kind"],
      "properties": {
        "archmap": { "const": 2 },
        "doc": { "const": "view" },
        "id": { "$ref": "#/$defs/id" },
        "verified": { "$ref": "#/$defs/verified" },
        "kind": { "enum": ["context", "structure", "execution", "data", "flow", "custom"] },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ref" },
          "description": "Elements selected for a structural projection. No coordinates or presentation styling belong here."
        },
        "relation_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relation-kind" }
        },
        "flow": { "$ref": "#/$defs/id", "description": "Flow id when kind=flow." },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "patternProperties": { "^x-": {} },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "flow" } }, "required": ["kind"] }, "then": { "required": ["flow"] }, "else": { "required": ["elements"] } }
      ]
    }
  }
}
