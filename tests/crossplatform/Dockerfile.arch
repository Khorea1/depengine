# Dockerfile for Arch Linux
FROM archlinux:latest

# Go toolchain from distro packages — test.sh runs `go build` inside the
# container (go.mod requires go 1.27; arch's `go` package tracks upstream).
# NOTE: keep the sync databases — depengine's native availability checks
# need the package index at test time.
RUN pacman -Sy --noconfirm \
    go \
    curl \
    git

# WORKDIR /app
# COPY . .
# RUN go build -o depengine .

# CMD ["./depengine"]
