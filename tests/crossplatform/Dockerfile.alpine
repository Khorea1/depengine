# Dockerfile for Alpine Linux
FROM alpine:latest

# Go toolchain from distro packages — test.sh runs `go build` inside the
# container (go.mod requires go 1.26; alpine's `go` package tracks upstream).
RUN apk update && apk add \
    go \
    curl \
    git \
    ca-certificates

