# Dockerfile for Debian
FROM debian:latest

# Go toolchain from distro packages — test.sh runs `go build` inside the
# container (go.mod requires go 1.26; golang-go is Debian's Go package).
RUN apt-get update && apt-get install -y --no-install-recommends \
    golang-go \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# WORKDIR /app
