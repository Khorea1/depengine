# Dockerfile for Debian
FROM debian:latest

# Go toolchain from distro packages — test.sh runs `go build` inside the
# container (go.mod requires go 1.27; golang-go is Debian's Go package).
# NOTE: keep /var/lib/apt/lists — depengine's native availability checks
# need the package index at test time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    golang-go \
    curl \
    git \
    ca-certificates

# WORKDIR /app
# COPY . .
# RUN go build -o depengine .

# For now, we'll assume depengine binary is copied in or available at runtime
