FROM golang:1.27-alpine

RUN apk add --no-cache git curl ca-certificates tar

WORKDIR /depengine
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /usr/local/bin/depengine .

# Alpine has no apt/pacman — tests native-unavailable fallback scenarios.
CMD ["depengine", "install", "--dry-run", "--verbose", "--schema", "tests/integration/test_schema.toml"]
