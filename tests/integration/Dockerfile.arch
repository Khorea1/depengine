FROM archlinux:latest

RUN pacman -Sy --noconfirm --needed \
    go git curl ca-certificates \
    && rm -rf /var/cache/pacman/pkg/*

WORKDIR /depengine
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /usr/local/bin/depengine .

CMD ["depengine", "install", "--dry-run", "--verbose", "--schema", "tests/integration/test_schema.toml"]
