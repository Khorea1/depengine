FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /depengine
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /usr/local/bin/depengine .

# Smoke test: dry-run
CMD ["depengine", "install", "--dry-run", "--verbose", "--schema", "tests/integration/test_schema.toml"]
